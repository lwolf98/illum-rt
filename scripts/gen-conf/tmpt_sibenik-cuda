# Format:
# pm_sib_p[pos]_[global photons]_[global estimate]_[caustics photons]_[caustics estimate]_[path len pass 1]_[path len pass 2]_[sppx]s.png
# ml_sib_p[pos]_[paths]x[path_len]_[vpl count]v_[gterm]_[sppx]s.png

# Outfile
outfile sibenik/[ALGO]_[SCENE]_cuda_p[POS]_[PATHS]x[LEN]_v_g[G_MAX]_[SPPX]s.png

# obj files
load render-data/sibenik/sibenik.obj

# Position
at [AT]
look [LOOK]
up 0 1 0

# Parameter
sppx [SPPX]
resolution [RES_W] [RES_H]

# Materials: special
material select pod
material ior  2.289
material roughness  0.055
material albedo  0.73412 0.70941 0.67412
# colored floor
#material albedo  0 0 1.0
#material texture drop

# Materials
material select kamen_zid_parapet
material albedo  0.73412 0.73059 0.67412
material ior  1.3
material roughness  0.50372

material select pod_tepih
material albedo  0.54627 0.21961 0.18392
material ior 1.3
material roughness  0.50372
        
material select sprljci
material albedo  0.78431 0.78431 0.78431
material ior 1.3
material roughness  0.50372

material select staklo
material emissive 7.8431 7.8431 7.8431
        
material select staklo_crveno
material emissive 50.118 8.392 0.562
        
material select staklo_plavo
material emissive 1.61177 2.82549 16.9216
        
material select staklo_zeleno
material emissive 1.9 18.3 2.15

# WF setup PM
#raytracer embree
#commit
#
#platform cpu
#add-scene-step build accel struct
#commit
#algo photon-mapping-wf

# WF setup ML
platform cuda
raytracer optix
add-scene-step build accel struct
algo manylight-wf
is light paths [PATHS] length [LEN] g [G_MAX] vps 1
commit

# Run
run
