# Format:
# pm_cor_[global photons]_[global estimate]_[caustics photons]_[caustics estimate]_[path len pass 1]_[path len pass 2]_[sppx]s.png
# ml_cor_[paths]x[path_len]_[vpl count]v_[gterm]_[sppx]s.png

# Outfile
#outfile cornell-box/[ALGO]_[SCENE]_prep_p[POS]_[PATHS]x[LEN]_v_g01_[SPPX]s.png
outfile cornell-box/test_cpu_prep.png

# obj files
#load render-data/cornell-mcguire/CornellBox-Water.obj
#load render-data/cornell-mcguire/CornellBox-Sphere.obj
load render-data/cornell-mcguire/CornellBox-Original.obj

# Position
at [AT]
look [LOOK]
up 0 1 0

# Parameter
resolution [RES_W] [RES_H]
raytracer embree
#algo photon-mapping
algo manylight paths [PATHS] length [LEN]
sppx [SPPX]

# Materials: light
material select light
material albedo 0.780 0.780 0.780
material roughness 0.900
material ior 1.500
#material emissive 10.000 10.000 10.000
material emissive 50 50 50

# Materials: special
#material select water
#material albedo 0.010 0.010 0.010
#material roughness 0.553
#material ior 1.330
#material brdf phong

#perfect mirror sphere
#material select leftSphere
#material albedo 0.010 0.010 0.010
#material roughness 0.001
#material ior 1.450
#material brdf phong

#glass sphere
#material select rightSphere
#material albedo 0.010 0.010 0.010
#material roughness 0.553
##material ior 2.500
#material ior 1.520
#material brdf phong

# Materials: default
material select floor
material albedo 0.725 0.710 0.680
material roughness 0.900
material ior 1.500
material brdf lambert

material select ceiling
material albedo 0.725 0.710 0.680
material roughness 0.900
material ior 1.500
material brdf lambert

material select backWall
material albedo 0.725 0.710 0.680
material roughness 0.900
material ior 1.500
material brdf lambert

material select rightWall
material albedo 0.161 0.133 0.427
#material albedo 0.683 0.689 0.427
#material albedo 0.000 1.000 0.000
material roughness 0.900
material ior 1.450
material brdf lambert

material select leftWall
material albedo 0.630 0.065 0.050
material roughness 0.900
material ior 1.450
material brdf lambert

# calculate VPLs
commit
vplcalc

# WF setup ML
platform cuda
raytracer optix
add-scene-step build accel struct
algo manylight-wf
is light paths [PATHS] length [LEN] vps 1
#algo direct-wf
#is light
#is uniform
commit

# Run
run
