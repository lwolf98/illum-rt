# Format:
# pm_spo_p[pos]_[global photons]_[global estimate]_[caustics photons]_[caustics estimate]_[path len pass 1]_[path len pass 2]_[sppx]s.png
# ml_spo_p[pos]_[paths]x[path_len]_[vpl count]v_[gterm]_[sppx]s.png

# Outfile
outfile san-miguel-test.png

# obj files
load render-data/san_miguel/san-miguel.obj

# Position 1
at 0 0.3 0
look -1 0 0
up 0 1 0

# Parameter
resolution 640 360

# Skylight
skylight load render-data/skylight-sunset.floats 30

# Materials: light
#material select Grass
#material emissive 10 10 10

raytracer embree
algo manylight paths 1024 length 10 g -1

commit
vplcalc

platform cuda
raytracer optix
add-scene-step build accel struct
#algo photon-mapping
algo manylight-wf
is light paths 1024 length 10 g -1 vps 1
#algo direct-wf
#is light
#algo primary-wf
sppx 1024

# Run
commit
run
