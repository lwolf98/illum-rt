# WF setup PM
#raytracer embree
#commit
#
#platform cpu
#add-scene-step build accel struct
#commit
#algo photon-mapping-wf

# WF setup ML
platform cuda
raytracer optix
add-scene-step build accel struct
algo manylight-wf
is light paths 70 length 1 vps 6
#algo direct-wf
#is light
#is uniform
commit

# Run
run
